// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model User{
  id String @id @default(uuid())
  username String @unique
  email String @unique
  passwordHash String 
  name String
  bio String?
  timezone String? @default("UTC")
  eventTypes EventType[]
  isVerified Boolean @default(false)
  verificationCode String?
  refreshToken String?
  passwordResetToken String? 
  passwordResetExpires DateTime?
  bookings Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

}

model EventType{
  id String @id @default(uuid())
  userId String 
  title String 
  slug String @unique
  description String
  durationMinutes Int
  locationType LocationType @default(VIRTUAL)
  locationDetails String?
  bufferBeforeMinutes Int @default(0)
  bufferAfterMinutes Int @default(0)
  dailyLimit Int?
  color String @default("#3498db")
  bookings Booking[]
  availabilityRules AvailabilityRule[]
  customQuestions CustomQuestion[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, slug])
}


model AvailabilityRule{
  id String @id @default(uuid())
  eventTypeId String 
  dayOfWeek Int  // day of week will be 0 - Monday ... 6 - Sunday
  startTime String
  endTime String
  dateOverride DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  @@index([eventTypeId])
}

model CustomQuestion{
  id String @id @default(uuid())
  eventTypeId String
  questionText String
  questionType QuestionType @default(TEXT)
  options Json?
  isRequired Boolean @default(true)
  customAnswers CustomAnswer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
}

model Booking{
  id String @id @default(uuid())
  eventTypeId String
  userId String
  startTime DateTime  
  endTime DateTime
  guestName String
  guestEmail String
  guestNotes String?
  status BookingStatus @default(CONFIRMED)
  videoLink String?
  reminderSent24H Boolean @default(false)
  reminderSent1H Boolean @default(false)
  cancellationToken String @unique
  customAnswers CustomAnswer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())


  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([startTime, endTime, userId, eventTypeId])
}

model CustomAnswer{
  id String @id @default(uuid())
  bookingId String
  questionId String
  answerText String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customQuestion CustomQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

}


enum QuestionType{
  MULTIPLE_CHOICE
  TEXT
  CHECKBOX
}

enum BookingStatus{
  CONFIRMED
  CANCELLED
  RESCHEDULED
}


enum LocationType{
  IN_PERSON
  VIRTUAL 
  PHONE 
  CUSTOM
}

